rules_version = '2';
// Authorization uses live profiles and parent documents in the default Firestore
// database. Enable the Storage service agent's Firestore read permission before
// deployment (see docs/SECURITY-REMEDIATION.md). Claims are not an authority here.
service firebase.storage {
  match /b/{bucket}/o {
    function profile() {
      return firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data;
    }
    function active() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/usuarios/$(request.auth.uid))
        && profile().get('ativo', true) != false;
    }
    function role() { return active() ? profile().get('role', '') : ''; }
    function internal() { return role() in ['engenharia','chefe','admin','codir','estagiario','administrativo']; }
    function team() { return role() in ['engenharia','chefe','admin','estagiario','administrativo']; }
    function technical() { return role() in ['engenharia','chefe','admin']; }
    function campusMember(campus) {
      return role() == 'campus' && (campus in profile().get('campi', []) || campus == profile().get('campus', ''));
    }
    function parent(col, id) { return firestore.get(/databases/(default)/documents/$(col)/$(id)).data; }
    function parentMatches(col, id, campus) {
      return firestore.exists(/databases/(default)/documents/$(col)/$(id)) && parent(col, id).campus == campus;
    }
    function canRead(col, id, campus) {
      return parentMatches(col, id, campus) && (internal() || campusMember(campus));
    }
    function canAttach(col, id, campus) {
      return parentMatches(col, id, campus) && parent(col, id).status != 'excluido'
        && (team() || (campusMember(campus)
          && (col == 'demandas' || parent(col, id).status in ['aberto','triagem','diligencia'])));
    }
    function validUpload() {
      return request.resource.size <= 10 * 1024 * 1024
        && (request.resource.contentType.matches('image/(jpeg|png|webp|heic|heif)') || request.resource.contentType == 'application/pdf')
        && request.resource.metadata.ownerUid == request.auth.uid;
    }
    function canDelete(col, id, campus) {
      return parentMatches(col, id, campus) && (technical()
        || (campusMember(campus) && canAttach(col,id,campus) && resource.metadata.get('ownerUid', '') == request.auth.uid));
    }
    match /chamados/{campus}/{id}/{file} {
      allow read: if canRead('chamados',id,campus);
      allow create: if resource == null && canAttach('chamados',id,campus) && validUpload();
      allow update: if false;
      allow delete: if canDelete('chamados',id,campus);
    }
    match /demandas/{campus}/{id}/{file} {
      allow read: if canRead('demandas',id,campus);
      allow create: if resource == null && canAttach('demandas',id,campus) && validUpload();
      allow update: if false;
      allow delete: if canDelete('demandas',id,campus);
    }
    match /perfis/{file} {
      allow read: if active();
      allow create, update: if active() && file == request.auth.uid + '.jpg'
        && request.resource.contentType == 'image/jpeg' && request.resource.size <= 300 * 1024;
      allow delete: if active() && (file == request.auth.uid + '.jpg' || role() == 'admin');
    }
    match /{path=**} { allow read, write: if false; }
  }
}
