rules_version = '2';
// =============================================================================
// Portal da Engenharia (cpii-seng) — Security Rules (Cloud Storage) — v4 (v2.0 — entrada única)
// Publicar: firebase deploy --only storage --project cpii-seng
//
// v1.31 (auditoria Codex #8/#9): as regras passam a consultar o FIRESTORE
// (cross-service, papel roles/firebaserules.firestoreServiceAgent concedido ao
// agente do Storage em 26/10/2026 — ver docs/ADR-002-chamados.md):
//   • #9 o perfil é lido AO VIVO em /usuarios/{uid} — desativar ou mudar o
//     papel vale na hora (fim da janela de ~1 h das custom claims);
//   • #8 o anexo só é gravado em registro EXISTENTE, do campus do caminho, e
//     no estado em que a interface permite (chamado do campus: aberto,
//     triagem ou diligência; demanda: qualquer estado fora do arquivo morto);
//   • sem sobrescrita (cada envio tem nome único); o campus só remove o que ele
//     mesmo enviou (metadado `uid` gravado no envio); a SENG técnica remove tudo.
// Tipos: imagem comum ou PDF, até 10 MB.
// =============================================================================
service firebase.storage {
  match /b/{bucket}/o {
    function perfil() {
      return firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data;
    }
    function papel() {
      return request.auth == null ? ''
        : (perfil().get('ativo', true) == false ? '' : perfil().get('role', ''));
    }
    function campiDoPerfil() {
      return perfil().get('campi', []).concat([perfil().get('campus', '')]);
    }
    function isInterno() { return papel() in ['engenharia', 'chefe', 'codir', 'admin', 'estagiario', 'administrativo']; }
    function isSeng() { return papel() in ['engenharia', 'chefe', 'admin']; }
    function isEquipe() { return papel() in ['engenharia', 'chefe', 'admin', 'estagiario', 'administrativo']; }
    function isCampusDe(c) { return papel() == 'campus' && c in campiDoPerfil(); }
    function tipoOk() {
      return request.resource.contentType.matches('image/(jpeg|png|webp|heic|heif)')
          || request.resource.contentType == 'application/pdf';
    }
    function envioOk() {
      return request.resource.size < 10 * 1024 * 1024 && tipoOk()
          && request.resource.metadata != null
          && request.resource.metadata.get('uid', '') == request.auth.uid;
    }
    function registro(col, id) {
      return firestore.get(/databases/(default)/documents/$(col)/$(id)).data;
    }
    function enviadoPorMim() {
      return resource.metadata != null && resource.metadata.get('uid', '') == request.auth.uid;
    }

    // v2.0 (ADR-004) — ENTRADA ÚNICA: anexos de chamado e de demanda do mesmo
    // registro em entradas/{campus}/{id}/{arquivo}. O estado vem da fase vigente:
    // na fase chamado, o campus envia/remove enquanto aberto, em triagem ou em
    // diligência; na fase demanda, fora do arquivo morto.
    function campusPodeMexer(e) {
      return (e.get('trilha', '') == 'chamado' && e.get('statusChamado', '') in ['aberto', 'triagem', 'diligencia'])
          || (e.get('trilha', '') == 'demanda' && e.get('status', '') != 'excluido');
    }
    match /entradas/{campus}/{id}/{arquivo} {
      allow read:   if isInterno() || isCampusDe(campus);
      allow create: if envioOk()
                    && registro('entradas', id).get('campus', '') == campus
                    && (isEquipe() || (isCampusDe(campus) && campusPodeMexer(registro('entradas', id))));
      allow update: if false;
      allow delete: if isSeng()
                    || (isCampusDe(campus) && enviadoPorMim() && campusPodeMexer(registro('entradas', id)));
    }
    // Caminhos LEGADOS (até a v1.31): somente leitura; remoção pela SENG técnica.
    // Os itens continuam referenciados nos anexos das entradas (path/url).
    match /chamados/{campus}/{chamadoId}/{arquivo} {
      allow read:   if isInterno() || isCampusDe(campus);
      allow create, update: if false;
      allow delete: if isSeng();
    }
    match /demandas/{campus}/{demandaId}/{arquivo} {
      allow read:   if isInterno() || isCampusDe(campus);
      allow create, update: if false;
      allow delete: if isSeng();
    }
    // Fotos de perfil (Meu espaço v1.20): perfis/{uid}.jpg — gravável só pelo
    // próprio usuário ativo; leitura por perfis ativos (exibição interna).
    match /perfis/{arquivo} {
      allow read:           if papel() != '';
      allow create, update: if papel() != ''
                            && arquivo == request.auth.uid + '.jpg'
                            && request.resource.contentType == 'image/jpeg'
                            && request.resource.size < 300 * 1024;
      allow delete:         if papel() != ''
                            && (arquivo == request.auth.uid + '.jpg' || papel() == 'admin');
    }
    // Diagnóstico da integração Storage↔Firestore (sem dados): leitura de um
    // objeto inexistente responde 404 se a consulta cross-service funcionar e
    // 403 se falhar. Mantido para verificação após mudanças de IAM/região.
    match /diag/crossservice {
      allow read: if firestore.exists(/databases/(default)/documents/config/params);
    }
    // Tudo o mais: negado.
    match /{allPaths=**} { allow read, write: if false; }
  }
}
